# Normalize line endings in the repository.
# On checkout, Windows users get CRLF; on the server, files are stored LF.
* text=auto

# Explicit rules for common source types
*.cpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
CMakeLists.txt text eol=lf

# Windows-only scripts must stay CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets
*.png   binary
*.ico   binary
*.ttf   binary
*.otf   binary
